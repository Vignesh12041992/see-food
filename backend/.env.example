# Environment variables for the backend (set these in Vercel > Project > Settings > Environment Variables,
# or export them in your shell for local development). The app does not read this file automatically.

# Required. Your OpenRouter API key (keep it secret).
OPENROUTER_API_KEY=

# Comma-separated list of web origins allowed to call the API. Include your deployed frontend.
# Default if unset: http://localhost:3000
ALLOWED_ORIGINS=https://see-food.vercel.app

# Public URL of your frontend, sent to OpenRouter as the HTTP-Referer attribution header.
# Default if unset: http://localhost:3000
APP_URL=https://see-food.vercel.app
